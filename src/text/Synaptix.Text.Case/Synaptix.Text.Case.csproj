<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <TargetFramework>netstandard2.0</TargetFramework>
    <MinVerTagPrefix>v-text-</MinVerTagPrefix>
  </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn)</NoWarn>
    </PropertyGroup>

    <!--
      Versioning: MinVer derives the version from the closest v-text-*
      git tag. Do not hardcode <Version>/<FileVersion>/<AssemblyVersion>
      here — MinVer's override takes precedence at build time.
    -->
    
    <PropertyGroup>
    </PropertyGroup>

    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    
    <PropertyGroup>
        <PackageIcon>stbl-128.png</PackageIcon>
        <PackageTags>text, string, case, extensions, dot, camel, kebab, train</PackageTags>
        <Description>Change any string case to PascalCase/camelCase/kebab-case/snake_case/Train-Case/dot.case</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\contents\stbl-128.png">
          <Pack>True</Pack>
          <PackagePath/>
          <Link>stbl-128.png</Link>
        </None>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!--
      Self-host Synaptix.Analyzers as a Roslyn analyzer reference.
      OutputItemType=Analyzer loads the DLL at compile time only;
      ReferenceOutputAssembly=false prevents transitive DLL propagation.
      Switch to <PackageReference Include="Synaptix.Analyzers" Version="1.0.0" />
      with PrivateAssets=all after first NuGet publish.
    -->
    <ItemGroup>
      <ProjectReference Include="..\..\analyzers\Synaptix.Analyzers\Synaptix.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    </ItemGroup>
    
</Project>